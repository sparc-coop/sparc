@page "/"
@using System.Threading.Tasks
@using Sparc.Blossom.Content

<PageTitle>Sparc Cooperative</PageTitle>

<section>
    <header>
        <img src="/img/gm-2.png" alt="Frog GM at Computer" />
        <h1>Tell us what's not working in your world</h1>
        <p>
            We're collecting real frustrations, big or small. The things that make you sigh,
            roll your eyes, or give up halfway. Let us know what's broken, confusing, or
            missing. We'll listen and maybe even fix it.
        </p>

        <PostForm />
    </header>

    <article class="galaxy">
        <figure>
            <img src="/img/human-beginning.gif" alt="Human Beginning" />
        </figure>
    </article>

    @* <ul>
        @foreach (var space in AllSpaces)
        {
            <li>
                <button @onclick="(() => Delete(space))">✕</button>
                <a href="@($"/spaces/{space.Id}")">
                    <SpaceCard Space="space" />
                </a>
            </li>
        }
    </ul> *@
</section>

@inject ISparcContent Tovik
@code
{
    List<BlossomSpace> AllSpaces = [];

    protected override async Task OnInitializedAsync()
    {
        AllSpaces = await Spaces.GetSpacesAsync();
    }

    private async Task Delete(BlossomSpace space)
    {
        await Spaces.DeleteSpaceAsync(space.Id);
        AllSpaces.Remove(space);
    }
}