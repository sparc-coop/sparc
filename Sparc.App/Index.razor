@page "/"
@using System.Threading.Tasks
@using Sparc.Blossom.Content

<PageTitle>Sparc Cooperative</PageTitle>

<section>
    <header>
        <img src="/img/gm-2.png" alt="Frog GM at Computer" />
        <h1>Tell us what's not working in your world</h1>
        <p>
            We're collecting real frustrations, big or small. The things that make you sigh,
            roll your eyes, or give up halfway. Let us know what's broken, confusing, or
            missing. We'll listen and maybe even fix it.
        </p>

        <PostForm OnUpdating="MarkSending" OnUpdate="MarkSent" />
    </header>

    <article class="galaxy">
        <figure>
            <img src="/img/human-beginning.gif" alt="Human Beginning" />
        </figure>

        @if (IsSpaceCreating)
        {
            <footer class="eight-bit">
                @if (!IsNotifySubmitted)
                {
                    <div class="forming-1 @(Space != null ? "done" : "")">
                        <div class="typewriter">Forming Galaxy....@(CompletionPercent)%</div>
                    </div>

                    @if (Space != null)
                    {
                        <div class="forming-2">
                            Formation paused: Universe still under construction.<br />
                            Do you want to be notified when it's 100% complete?
                        </div>
                        <form class="forming-3" @onsubmit="@(() => SubmitNotify())" @onkeydown="MaybeSubmitNotify">
                            <label>
                                <input type="radio" name="Notify" checked="@ShouldNotify" @ref="RadioInput" @onchange="@(() => ShouldNotify = true)" />
                                <span @onclick="@(() => SubmitNotify(true))">Yes, notify me</span>
                            </label>
                            <label >
                                <input type="radio" name="Notify" checked="@(!ShouldNotify)" @onchange="@(() => ShouldNotify = false)" />
                                <span @onclick="@(() => SubmitNotify(false))">No thanks</span>
                            </label>
                        </form>
                    }
                }
                else if (ShouldNotify == false)
                {
                    <div class="forming-4">
                        <div class="typewriter">No worries!</div>
                    </div>
                    <div class="forming-5">
                        Keep monitoring this page for updates to your new space.
                    </div>
                }
                else if (!IsRegistered)
                {
                    <div class="forming-4">
                        <div class="typewriter">Establishing comms link........ Where should we send the transmission?</div>
                    </div>
                    <form class="forming-5" @onsubmit="ConnectEmail">
                        <label>
                            Type your email...
                            <input type="email" @ref="EmailInput" @bind="Email" />
                        </label>
                    </form>
                }
                else
                {
                    <div class="forming-4">
                        <div class="typewriter">Thank you!</div>
                    </div>
                    <div class="forming-5">
                         We will be in touch as soon as you can explore your new space.
                    </div>
                }
            </footer>
        }
    </article>

    @* <ul>
        @foreach (var space in AllSpaces)
        {
            <li>
                <button @onclick="(() => Delete(space))">✕</button>
                <a href="@($"/spaces/{space.Id}")">
                    <SpaceCard Space="space" />
                </a>
            </li>
        }
    </ul> *@
</section>

@inject ISparcContent Tovik
@code
{
    List<BlossomSpace> AllSpaces = [];
    BlossomSpace? Space;
    bool ShouldNotify = true;
    bool IsSpaceCreating;
    bool IsRegistered;
    bool IsNotifySubmitted;
    int CompletionPercent;
    string Email = "";
    Timer? ProgressTimer;
    ElementReference? EmailInput;
    ElementReference? RadioInput;
    BlossomUser? UserInfo;

    protected override async Task OnInitializedAsync()
    {
        AllSpaces = await Spaces.GetSpacesAsync();
        UserInfo = await Aura.UserInfo();
    }

    async Task MarkSending()
    {
        IsSpaceCreating = true;
        CompletionPercent = 0;
        ProgressTimer = new Timer(_ =>
        {
            if (Space != null || CompletionPercent >= 99)
            {
                ProgressTimer?.Dispose();
            }
            else
            {
                CompletionPercent += 1;
                InvokeAsync(StateHasChanged);
            }
        }, null, 0, 300);
    }

    async Task MarkSent(BlossomSpace space)
    {
        Space = space;
        StateHasChanged();

        if (RadioInput != null)
            await RadioInput.Value.FocusAsync();
    }

    async Task MaybeSubmitNotify(KeyboardEventArgs args)
    {
        if (args.Code == "Enter" || args.Code == "NumpadEnter")
            await SubmitNotify();
    }

    async Task SubmitNotify(bool? shouldNotify = null)
    {
        if (shouldNotify.HasValue)
            ShouldNotify = shouldNotify.Value;

        IsNotifySubmitted = true;
        StateHasChanged();

        if (EmailInput != null)
            await EmailInput.Value.FocusAsync();
    }

    async Task ConnectEmail()
    {
        await Aura.Login(Email);
        IsRegistered = true;
    }

    private async Task Delete(BlossomSpace space)
    {
        await Spaces.DeleteSpaceAsync(space.Id);
        AllSpaces.Remove(space);
    }
}