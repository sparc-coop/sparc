@page "/"
@using System.Threading.Tasks
@using Sparc.Blossom.Content

<PageTitle>Sparc Cooperative</PageTitle>

<section>
    <header>
        <img src="/img/gm-2.png" alt="Frog GM at Computer" />
        <h1>Tell us what's not working in your world</h1>
        <p>
            We're collecting real frustrations, big or small. The things that make you sigh,
            roll your eyes, or give up halfway. Let us know what's broken, confusing, or
            missing. We'll listen and maybe even fix it.
        </p>

        <PostForm OnUpdating="MarkSending" OnUpdate="MarkSent" />
    </header>

    <article class="galaxy">
        <figure>
            <img src="/img/human-beginning.gif" alt="Human Beginning" />
        </figure>

        @if (IsSpaceCreating)
        {
            <footer class="eight-bit">
                @if (ShouldNotify == null)
                {
                    <div class="forming-1 @(Space != null ? "done" : "")">
                        <div class="typewriter">Forming Galaxy....@(CompletionPercent)%</div>
                    </div>

                    @if (Space != null)
                    {
                        <div class="forming-2">
                            Formation paused: Universe still under construction.<br />
                            Do you want to be notified when it's 100% complete?
                        </div>
                        <form class="forming-3" @onsubmit=Notify>
                            <label @onclick="Notify">
                                <input type="radio" name="Notify" checked />
                                Yes, notify me
                            </label>
                            <label @onclick="@(() => ShouldNotify = false)">
                                <input type="radio" name="Notify" />
                                No thanks
                            </label>
                        </form>
                    }
                }
                else if (!IsRegistered)
                {
                    <div class="forming-4">
                        <div class="typewriter">Establishing comms link........ Where should we send the transmission?</div>
                    </div>
                    <form class="forming-5" @onsubmit="ConnectEmail">
                        <label>
                            Type your email...
                            <input type="email" @ref="EmailInput" @bind="Email" />
                        </label>
                    </form>
                }
                else
                {
                    <div class="forming-4">
                        <div class="typewriter">Thank you! We will be in touch as soon as you can explore your new space.</div>
                    </div>
                }
            </footer>
        }
    </article>

    @* <ul>
        @foreach (var space in AllSpaces)
        {
            <li>
                <button @onclick="(() => Delete(space))">✕</button>
                <a href="@($"/spaces/{space.Id}")">
                    <SpaceCard Space="space" />
                </a>
            </li>
        }
    </ul> *@
</section>

@inject ISparcContent Tovik
@code
{
    List<BlossomSpace> AllSpaces = [];
    BlossomSpace? Space;
    bool? ShouldNotify;
    bool IsSpaceCreating;
    bool IsRegistered;
    int CompletionPercent;
    string Email = "";
    Timer? ProgressTimer;
    ElementReference? EmailInput;

    protected override async Task OnInitializedAsync()
    {
        AllSpaces = await Spaces.GetSpacesAsync();
    }

    async Task MarkSending()
    {
        IsSpaceCreating = true;
        CompletionPercent = 0;
        ProgressTimer = new Timer(_ =>
        {
            if (Space != null || CompletionPercent >= 99)
            {
                ProgressTimer?.Dispose();
            }
            else
            {
                CompletionPercent += 1;
                InvokeAsync(StateHasChanged);
            }
        }, null, 0, 100);
    }

    async Task MarkSent(BlossomSpace space)
    {
        Space = space;
    }

    async Task Notify()
    {
        ShouldNotify = true;
        StateHasChanged();

        if (EmailInput != null)
            await EmailInput.Value.FocusAsync();
    }

    async Task ConnectEmail()
    {
        await Aura.Login(Email);
        IsRegistered = true;
    }

    private async Task Delete(BlossomSpace space)
    {
        await Spaces.DeleteSpaceAsync(space.Id);
        AllSpaces.Remove(space);
    }
}