@page "/"
@using System.Threading.Tasks
@using Sparc.Blossom.Content

<PageTitle>Sparc Cooperative</PageTitle>

<section>
    <header>
        <h1>Tell us what's not working in your world</h1>
        <p>
            We're collecting real frustrations, big or small. The things that make you sigh,
            roll your eyes, or give up halfway. Let us know what's broken, confusing, or
            missing. We'll listen and maybe even fix it.
        </p>
    </header>

    <form @onsubmit="AddIdea" @onsubmit:preventDefault=true>
        <textarea placeholder="Anything that annoys you or slows you down!" @bind=IdeaText></textarea>
        <button type="submit">Submit</button>
        @if (Error is not null)
        {
            <p class="error">@Error</p>
        }
    </form>

    <ul>
        @foreach (var idea in Ideas)
        {
            <li>
                <IdeaCard Idea="idea" />
            </li>
        }
    </ul>
</section>

@inject IRepository<Idea> IdeaRepository
@inject ITovik Tovik
@code
{
    List<Idea> Ideas = [];
    BlossomUser? User;
    string? Error;
    string IdeaText { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        User = await Aura.UserInfo();
        Ideas = await IdeaRepository.GetAllAsync();
        Ideas = Ideas.OrderByDescending(x => x.PostDate).ToList();
    }

    private async Task AddIdea()
    {
        Error = null;
        Idea idea = new(User!.Avatar, IdeaText);
        Ideas.Insert(0, idea);
        StateHasChanged();

        var categories = Ideas.Select(x => x.Category)
        .Where(x => x != null)
        .Distinct()
        .ToList();

        if (!await idea.Validate(Tovik, categories!))
        {
            Error = "Please provide a valid idea.";
        }
        else
        {
            Error = null;
            await IdeaRepository.AddAsync(idea);
        }

        IdeaText = string.Empty;
    }
}