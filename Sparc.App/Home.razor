@page "/"
@using System.Threading.Tasks
@using Sparc.Blossom.Content

<PageTitle>Sparc Cooperative</PageTitle>

<section>
    <header>
        <h1>Tell us what's not working in your world</h1>
        <p>
            We're collecting real frustrations, big or small. The things that make you sigh,
            roll your eyes, or give up halfway. Let us know what's broken, confusing, or
            missing. We'll listen and maybe even fix it.
        </p>
    </header>

    <form @onsubmit="AddPost" @onsubmit:preventDefault=true>
        <textarea placeholder="Anything that annoys you or slows you down!" @bind=PostText></textarea>
        <button type="submit">Submit</button>
        @if (Error is not null)
        {
            <p class="error">@Error</p>
        }
    </form>

    <ul>
        @foreach (var post in Posts)
        {
            <li @onclick="@(() => Select(post))">
                <PostCard Post="post" />
            </li>
        }
    </ul>
</section>

@if (SelectedPost != null)
{
    <aside>
        <PostEntities Post="SelectedPost" />
    </aside>
}

@inject IRepository<SparcPost> PostRepository
@inject ISparcContent Tovik
@code
{
    List<SparcPost> Posts = [];
    SparcPost? SelectedPost;
    BlossomUser? User;
    string? Error;
    string PostText { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        User = await Aura.UserInfo();
        Posts = await PostRepository.GetAllAsync();
        Posts = Posts.OrderByDescending(x => x.Timestamp).ToList();
    }

    private async Task AddPost()
    {
        Error = null;
        SparcPost post = new(User!, PostText);
        Posts.Insert(0, post);
        StateHasChanged();

        await post.ExtractGraph(Tovik);
        await PostRepository.AddAsync(post);
        PostText = string.Empty;
        SelectedPost = post;
    }

    private void Select(SparcPost post)
    {
        SelectedPost = post;
    }
}