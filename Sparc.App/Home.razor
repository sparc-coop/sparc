@page "/"
@using System.Threading.Tasks
@using Sparc.Blossom.Content

<PageTitle>Sparc Cooperative</PageTitle>

<section>
    <header>
        <h1>Tell us what's not working in your world</h1>
        <p>
            We're collecting real frustrations, big or small. The things that make you sigh,
            roll your eyes, or give up halfway. Let us know what's broken, confusing, or
            missing. We'll listen and maybe even fix it.
        </p>
    </header>

    <form @onsubmit="AddPost" @onsubmit:preventDefault=true>
        <textarea placeholder="Search or type anything..." @onkeydown="Enter" @onkeydown:preventDefault=IsEnter @bind=PostText @bind:event="oninput"></textarea>
        <button type="submit" disabled="@(PostText.Length == 0)">
            <img src="/img/Submit.svg" alt="Submit" />
        </button>
        @if (Error is not null)
        {
            <p class="error">@Error</p>
        }
    </form>

    <ul>
        @foreach (var space in AllSpaces)
        {
            <li>
                <a href="@($"/spaces/{space.Id}")">
                    <SpaceCard Space="space" />
                </a>
            </li>
        }
    </ul>
</section>

@inject ISparcContent Tovik
@code
{
    List<BlossomSpace> AllSpaces = [];
    BlossomUser? User;
    string? Error;
    string PostText { get; set; } = string.Empty;
    bool IsEnter;

    protected override async Task OnInitializedAsync()
    {
        User = await Aura.UserInfo();
        AllSpaces = await Spaces.GetSpacesAsync("kuviocreative.com", "conseris");
    }

    public async Task Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            IsEnter = true;
            await AddPost();
        }
        else
            IsEnter = false;
    }

    private async Task AddPost()
    {
        PostText = PostText.TrimEnd('\r', '\n');
        Error = null;
