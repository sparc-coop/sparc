@inherits LayoutComponentBase

<header>
    <a href="/">
        <figure>
            <img src="img/SparcLogo.svg" alt="Sparc" />
        </figure>
    </a>
    
    <nav>
        <ul>
            <li>
                <a href="/Projects">Projects</a>
            </li>
            <li>
                <a href="/Community">Community</a>
            </li>
            <li>
                <SparcAura />
            </li>
        </ul>
        <div>
            <AnimatedMenuToggle OnToggle="ToggleMobileMenu" />
        </div>
    </nav>
</header>

<main>
    @Body
</main>

@code {
    private bool showMobileMenu = false;
    private void ToggleMobileMenu(bool isOpen)
    {
        showMobileMenu = isOpen;
    }

}