<section>
    <header>
        Quests
    </header>

    <figure>
        <img src="./SpaceGame/starfield/sprites/gm.png" />
        <figcaption>
            Here is the list of quests.
        </figcaption>
    </figure>

    <ul id="quests">
        @foreach (var quest in Quests)
        {
            <li class="@(SelectedQuest?.Id == quest.Id ? "active" : "")">
                <div>
                <figure></figure>
                    @if (quest.Coordinates?.Length != null)
                    {
                        <aside>@quest.Coordinates.Length.ToString("0.##") ly</aside>
                    }
                </div>
                <div>
                    <h3>@quest.Summary?.RightTopic</h3>
                    <p>@quest.Summary?.Description</p>
                </div>
                <button class="icon" @onclick="@(() => SelectQuest(quest))">
                    <img src="./SpaceGame/starfield/sprites/start_quest.png" alt="Go to Quest" />
                </button>
            </li>
        }
    </ul>
</section>


@code {
    [Parameter] public required List<Quest> Quests { get; set; }
    [Parameter] public required List<Facet> Facets { get; set; }
    [Parameter] public EventCallback<BlossomSpaceObject?> OnSelect { get; set; }
    BlossomSpaceObject? SelectedQuest;

    async Task SelectQuest(BlossomSpaceObject quest)
    {
        if (SelectedQuest?.Id == quest.Id)
            SelectedQuest = null;
        else
            SelectedQuest = quest;
        await OnSelect.InvokeAsync(SelectedQuest);
    }
}