<section>
    <header>
        Quests
    </header>

    <figure>
        <img src="./SpaceGame/starfield/sprites/gm.png" />
        <figcaption>
            Here is the list of quests.
        </figcaption>
    </figure>

    <ul id="quests">
        @foreach (var facet in Facets)
        {
            <li class="@(SelectedQuest?.Id == facet.Id ? "active" : "")">
                <div>
                <figure></figure>
                    @if (facet.Coordinates?.Length != null)
                    {
                        <aside>@facet.Coordinates.Length.ToString("0.##") ly</aside>
                    }
                </div>
                <div>
                    <h3>@facet.Summary?.RightTopic</h3>
                    <p>@facet.Summary?.Description</p>
                </div>
                <button class="icon" @onclick="@(() => SelectQuest(facet))">
                    <img src="./SpaceGame/starfield/sprites/start_quest.png" alt="Go to Quest" />
                </button>
            </li>
        }
    </ul>
</section>


@code {
    [Parameter] public required List<Facet> Facets { get; set; }
    [Parameter] public EventCallback<BlossomSpaceObject?> OnSelect { get; set; }
    [Parameter] public BlossomSpaceObject? SelectedQuest { get; set; }

    async Task SelectQuest(BlossomSpaceObject quest)
    {
        if (SelectedQuest?.Id == quest.Id)
            SelectedQuest = null;
        else
            SelectedQuest = quest;
        await OnSelect.InvokeAsync(SelectedQuest);
    }
}