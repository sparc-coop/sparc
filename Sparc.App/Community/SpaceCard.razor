<article>
    <figure>
        <figcaption>
            Ideation
            <img src="/img/ArrowRight.svg" alt="Go to project" />
        </figcaption>
    </figure>
    <div>
        <header>
            <h2>
                @Space.Name
            </h2>
        </header>
        <p>
            @Space.Summary?.Topic
        </p>

        <aside>
            @Space.Distance.Pretty() ly @(Space.EntityType == "Quest" ? "to next turn" : "to the answer")
        </aside>
        <aside>
            Current Coherence: @Space.Coherence.ToString("0.##")
        </aside>
    </div>
</article>

@code {
    [Parameter] public required BlossomSpace Space { get; set; }
}
