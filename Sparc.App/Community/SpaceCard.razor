<article>
    <figure>
        <figcaption>
            Ideation
            <img src="/img/ArrowRight.svg" alt="Go to project" />
        </figcaption>
    </figure>
    <div>
        <header>
            <h2>
                @Space.Name
            </h2>
        </header>
        <p>
            @Space.Summary?.Topic
        </p>

        @if (DistanceToAnswer is not null)
        {
            <aside>
                @DistanceToAnswer.Value.ToString("0.##") ly to the answer
            </aside>
        }
        <aside>
                Current Coherence: @Space.Coherence.ToString("0.##")
            </aside>
    </div>
</article>

@code {
    [Parameter] public required BlossomSpace Space { get; set; }
    [Parameter] public double? DistanceToAnswer { get; set;  }
}
