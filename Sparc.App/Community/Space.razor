@page "/spaces/{Id}"
@page "/spaces/{ParentSpaceId}/subspaces/{Id}"

<article>
    <div id="game"></div>

    @if (GameState is not null)
    {
        <div id="buttons">
        @if (GameState.AvailableQuests.Any())
        {
            <button @onclick="ToggleQuests">
                <img src="./SpaceGame/starfield/sprites/exclamation.png" alt="Show Quests" />
            </button>
        }
        </div>

        @if (ShowQuests)
        {
            <SpaceQuests AvailableQuests="GameState.AvailableQuests" UserSpace="GameState.Self" OnUpdate="UpdateGameObjects" />
        }

        <div id="hud">
            <section class="project">
                <header>
                    Project
                </header>
                <SpaceCard Space="GameState.Space" DistanceToAnswer="GameState.DistanceToAnswer" />
            </section>

            <section class="details">
                <header>
                    <ul>
                        <li class="@(ActiveTab == "Discoveries" ? "active" : "")" @onclick="@(() => SetActiveTab("Discoveries"))">Discoveries</li>
                        <li class="@(ActiveTab == "Frog" ? "active" : "")" @onclick="@(() => SetActiveTab("Frog"))">Frog GM</li>
                        <li class="@(ActiveTab == "Settings" ? "active" : "")" @onclick="@(() => SetActiveTab("Settings"))">Settings</li>
                    </ul>
                </header>

                @if (ActiveTab == "Discoveries")
                {
                    <div class="discoveries">
                        <SpaceDiscussion GameState="GameState" OnUpdate="UpdateGameObjects" OnSelect="Select" @ref="SpaceDiscussionRef" />
                    </div>
                }
                else if (ActiveTab == "Frog")
                {
                    <div class="frog">
                        <SpaceDiscussion GameState="GameState" OnUpdate="UpdateGameObjects" OnSelect="Select" Type="Hint" />
                    </div>
                }
                else if (ActiveTab == "Settings")
                {
                    <div class="settings">
                        <SpaceSettings CurrentSpace="GameState.Space" User="User" OnUpdate="UpdateGameObjects" />
                    </div>
                }
            </section>
        </div>
    }
</article>

@inject ISparcAura Aura
@code {
        [Parameter] public required string Id { get; set; }
        [Parameter] public string? ParentSpaceId { get; set; }
        List<Post> Discoveries = [];
        BlossomSpaceObject? SelectedQuest;
        BlossomUser? User;
        SpaceDiscussion? SpaceDiscussionRef;
        IJSObjectReference? Game;
        string ActiveTab = "Discoveries";
        bool ShowQuests;
        GameState? GameState;

    protected override async Task OnParametersSetAsync()
    {
        User = await Aura.UserInfo();
        await UpdateGameObjects();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Game == null)
        {
            Game = await Js.ImportAsync("./SpaceGame/SpaceGame.js");
            await Game.InvokeVoidAsync("start", GameState);
        }
    }

    async Task UpdateGameObjects()
    {
        GameState = await Spaces.GetCoordinatesAsync(Id);

        if (Game != null)
            await Game.InvokeVoidAsync("update", GameState, DotNetObjectReference.Create(this));
    }

    void SetActiveTab(string tab)
    {
        ActiveTab = tab;
    }

    async Task Select(Post? post) => await Select(post?.Id);

    async Task Select(string? id)
    {
        if (Game != null)
            await Game.InvokeVoidAsync("select", id);
    }

    async Task SelectQuest(BlossomSpaceObject quest)
    {
        if (SelectedQuest?.Id == quest?.Id)
            SelectedQuest = null;
        else
            SelectedQuest = quest;

        await UpdateGameObjects();
    }

    [JSInvokable("SelectGameObject")]
    public async Task SelectGameObject(string id)
    {
        var obj = GameState!.Posts.FirstOrDefault(x => x.Id == id);
        if (obj != null)
        {
            if (obj.EntityType == "Quest")
                await SelectQuest(obj);
            else if (obj.EntityType == "Post")
                await SpaceDiscussionRef!.Select(obj.Id);
        }
    }

    void ToggleQuests() => ShowQuests = !ShowQuests;
}