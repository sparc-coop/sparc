@page "/spaces/{Id}"
@page "/spaces/{ParentSpaceId}/subspaces/{Id}"
@using Sparc.Blossom.Content

@if (CurrentSpace is not null)
{
    <article>
        <SpaceGame GameObjects="GameObjects" @ref="Game" />
        <PostForm Space="CurrentSpace" OnUpdate="Update" />
    </article>
}

@code {
    [Parameter] public required string Id { get; set; }
    [Parameter] public string? ParentSpaceId { get; set; }
    BlossomSpace? CurrentSpace;
    BlossomSpace? UserSpace;
    SpaceGame? Game;
    List<LinkedSpace> GameObjects = [];
    List<BlossomPost> Posts = [];

    protected override async Task OnParametersSetAsync()
    {
        await Update();
    }

    async Task Update()
    {
        CurrentSpace = await Spaces.GetSpaceAsync(ParentSpaceId ?? "sparc.coop", Id);
        UserSpace = await Spaces.GetSpaceAsync(Id, "User");
        Posts = await Spaces.GetPostsAsync(CurrentSpace!.Id);

        if (UserSpace != null)
        {
            GameObjects = Posts.Select(p => p.LinkedSpace(UserSpace.Id))
            .Where(ls => ls != null)
            .Select(x => x! with { Type = "Post" })
            .ToList()!;

        }

        var spaceObjects = CurrentSpace.LinkedSpaces
            .Select(x => x.SpaceId == UserSpace?.Id ? x with { Type = "Self" } : x)
            .ToList();

        GameObjects.AddRange(spaceObjects);
    }
}
