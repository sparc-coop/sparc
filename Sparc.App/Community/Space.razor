@page "/spaces/{Id}"
@page "/spaces/{ParentSpaceId}/subspaces/{Id}"

<article>
    <div id="game"></div>

    @if (CurrentSpace is not null)
    {
        <div id="buttons">
        @if (GameObjects.Any(x => x.Type == "Quest"))
        {
            <button @onclick="ToggleQuests">
                <img src="./SpaceGame/starfield/sprites/exclamation.png" alt="Show Quests" />
            </button>
        }
        </div>

        @if (ShowQuests)
        {
            <SpaceQuests GameObjects="GameObjects" OnSelect="SelectQuest" />
        }

        <div id="hud">
            <section class="project">
                <header>
                    Project
                </header>
                <SpaceCard Space="CurrentSpace" GameState="GameState" />
            </section>

            <section class="details">
                <header>
                    <ul>
                        <li class="@(ActiveTab == "Discoveries" ? "active" : "")" @onclick="@(() => SetActiveTab("Discoveries"))">Discoveries</li>
                        <li class="@(ActiveTab == "Frog" ? "active" : "")" @onclick="@(() => SetActiveTab("Frog"))">Frog GM</li>
                        <li class="@(ActiveTab == "Settings" ? "active" : "")" @onclick="@(() => SetActiveTab("Settings"))">Settings</li>
                    </ul>
                </header>

                @if (ActiveTab == "Discoveries")
                {
                    <div class="discoveries">
                        <SpaceDiscussion Space="CurrentSpace" OnUpdate="Update" OnSelect="Select" @ref="SpaceDiscussionRef" />
                    </div>
                }
                else if (ActiveTab == "Frog")
                {
                    <div class="frog">
                        <SpaceDiscussion Space="CurrentSpace" OnUpdate="Update" OnSelect="Select" Type="Hint" />
                    </div>
                }
                else if (ActiveTab == "Settings")
                {
                    <div class="settings">
                        <SpaceSettings CurrentSpace="CurrentSpace" User="User" UserSpace="UserSpace" OnUpdate="Update" />
                    </div>
                }
            </section>
        </div>
    }
</article>

@inject ISparcAura Aura
@code {
    [Parameter] public required string Id { get; set; }
    [Parameter] public string? ParentSpaceId { get; set; }
    BlossomSpace? CurrentSpace;
    BlossomSpace? UserSpace;
    List<BlossomCoordinate> GameObjects = [];
    List<BlossomPost> Discoveries = [];
    BlossomCoordinate? SelectedQuest;
    BlossomUser? User;
    SpaceDiscussion? SpaceDiscussionRef;
    IJSObjectReference? Game;
    string ActiveTab = "Discoveries";
    bool ShowQuests;
    GameState? GameState;

    protected override async Task OnParametersSetAsync()
    {
        User = await Aura.UserInfo();
        await Update();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Game == null)
        {
            Game = await Js.ImportAsync("./SpaceGame/SpaceGame.js");
            await Game.InvokeVoidAsync("start", GameObjects);
        }
    }

    async Task Update()
    {
        CurrentSpace = await Spaces.GetSpaceAsync(ParentSpaceId ?? "sparc.coop", Id);
        UserSpace = await Spaces.GetSpaceAsync(Id, User!.Avatar.Id);
        await UpdateGameObjects();
    }

    async Task UpdateGameObjects()
    {
        GameState = await Spaces.GetCoordinatesAsync(Id, SelectedQuest?.Id);
        GameObjects = GameState.Coordinates;

        // Set current user to Self (should move this to backend)
        GameObjects = GameObjects.Select(x => x.Id == User!.Avatar.Id ? x with { Type = "Self" } : x).ToList();
        if (Game != null)
            await Game.InvokeVoidAsync("update", GameObjects, DotNetObjectReference.Create(this));
    }

    void SetActiveTab(string tab)
    {
        ActiveTab = tab;
    }

    async Task Select(BlossomPost? post) => await Select(post?.Id);

    async Task Select(string? id)
    {
        if (Game != null)
            await Game.InvokeVoidAsync("select", id);
    }

    async Task SelectQuest(BlossomCoordinate quest)
    {
        if (SelectedQuest?.Id == quest?.Id)
            SelectedQuest = null;
        else
            SelectedQuest = quest;

        await UpdateGameObjects();
    }

    [JSInvokable("SelectGameObject")]
    public async Task SelectGameObject(string id)
    {
        var obj = GameObjects.FirstOrDefault(x => x.Id == id);
        if (obj != null)
        {
            if (obj.Type == "Quest")
                await SelectQuest(obj);
            else if (obj.Type == "Post")
                await SpaceDiscussionRef!.Select(obj.Id);
        }
    }

    void ToggleQuests() => ShowQuests = !ShowQuests;
}