@page "/spaces/{Id}"
@page "/spaces/{ParentSpaceId}/subspaces/{Id}"
@using Sparc.Blossom.Content

@if (CurrentSpace is not null)
{
    <article>
        <SpaceGame GameObjects="GameObjects" @ref="Game" />
        <PostForm Space="CurrentSpace" OnUpdate="Update" />

        <div class="settings">
            <h3>Space Settings</h3>
            <div>Signed In as @User?.Avatar.Username</div>
            <div>Viewing from Space @UserSpace?.Id (@Id / @User?.Id)</div>
            <label>
                User Self-Confidence:
                <input type="number" step="0.01" @bind="CurrentSpace.Settings.HeadspaceVelocity" />
            </label>
            <label>
                User Openness to New Ideas:
                <input type="number" step="0.01" @bind="CurrentSpace.Settings.UserHeadspaceWeight" />
            </label>
            <label>
                Answer Flexibility:
                <input type="number" step="0.01" @bind="CurrentSpace.Settings.SpaceGravity" />
            </label>
            <label>
                Number of Messages to Lookback:
                <input type="number" @bind="CurrentSpace.Settings.MessageLookback" />
            </label>
            <label>
                Message Lookback Weight:
                <input type="number" step="0.01" @bind="CurrentSpace.Settings.MessageLookbackWeight" />
            </label>
            <button @onclick="SaveSettings">Save</button>
        </div>

        <div>
            <h3>Coordinates</h3>
            <ul>
                @foreach (var coordinate in GameObjects)
                {
                    <li>@coordinate.Type @coordinate.Id: @coordinate.Name (@coordinate.X, @coordinate.Y, @coordinate.Z)</li>
                }
            </ul>
        </div>
    </article>
}
@inject ISparcAura Aura
@code {
    [Parameter] public required string Id { get; set; }
    [Parameter] public string? ParentSpaceId { get; set; }
    BlossomSpace? CurrentSpace;
    BlossomSpace? UserSpace;
    SpaceGame? Game;
    List<BlossomCoordinate> GameObjects = [];
    BlossomUser? User;

    protected override async Task OnParametersSetAsync()
    {
        await Update();
    }

    async Task Update()
    {
        CurrentSpace = await Spaces.GetSpaceAsync(ParentSpaceId ?? "sparc.coop", Id);
        User = await Aura.UserInfo();
        UserSpace = await Spaces.GetSpaceAsync(Id, User.Avatar.Id);
        GameObjects = await Spaces.GetCoordinatesAsync(Id);
        
        // Set current user to Self (should move this to backend)
        GameObjects = GameObjects.Select(x => x.Id == User.Avatar.Id ? x with { Type = "Self" } : x).ToList();
    }

    async Task SaveSettings()
    {
        await Spaces.SaveSpaceAsync(CurrentSpace!.Id, CurrentSpace);
        await Update();
    }
}
