@page "/spaces/{Id}"
@page "/spaces/{ParentSpaceId}/subspaces/{Id}"
@using Sparc.Blossom.Content

<article>
    <div id="game"></div>

    @if (CurrentSpace is not null)
    {
        <div id="hud">
            <section class="project">
                <header>
                    Project
                </header>
                <SpaceCard Space="CurrentSpace" />
            </section>

            <section class="details">
                <header>
                    <ul>
                        <li class="@(ActiveTab == "Discoveries" ? "active" : "")" @onclick="@(() => SetActiveTab("Discoveries"))">Discoveries</li>
                        <li class="@(ActiveTab == "Frog" ? "active" : "")" @onclick="@(() => SetActiveTab("Frog"))">Frog GM</li>
                        <li class="@(ActiveTab == "Settings" ? "active" : "")" @onclick="@(() => SetActiveTab("Settings"))">Settings</li>
                    </ul>
                </header>

                @if (ActiveTab == "Discoveries")
                {
                    <div class="discoveries">
                        <SpaceDiscussion Space="CurrentSpace" OnUpdate="Update" OnSelect="Select" />
                    </div>
                }
                else if (ActiveTab == "Frog")
                {
                    <div class="frog">
                    </div>
                }
                else if (ActiveTab == "Settings")
                {
                    <div class="settings">
                        <SpaceSettings CurrentSpace="CurrentSpace" User="User" UserSpace="UserSpace" OnUpdate="Update" />
                    </div>
                }
            </section>
        </div>
    }
</article>

@inject ISparcAura Aura
@code {
    [Parameter] public required string Id { get; set; }
    [Parameter] public string? ParentSpaceId { get; set; }
    BlossomSpace? CurrentSpace;
    BlossomSpace? UserSpace;
    List<BlossomCoordinate> GameObjects = [];
    List<BlossomPost> Discoveries = [];
    BlossomUser? User;
    IJSObjectReference? Game;
    string ActiveTab = "Discoveries";

    protected override async Task OnParametersSetAsync()
    {
        User = await Aura.UserInfo();
        await Update();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Game == null)
        {
            Game = await Js.ImportAsync("./SpaceGame/SpaceGame.js");
            await Game.InvokeVoidAsync("start", GameObjects);
        }
    }

    async Task Update()
    {
        CurrentSpace = await Spaces.GetSpaceAsync(ParentSpaceId ?? "sparc.coop", Id);
        UserSpace = await Spaces.GetSpaceAsync(Id, User!.Avatar.Id);
        GameObjects = await Spaces.GetCoordinatesAsync(Id);

        // Set current user to Self (should move this to backend)
        GameObjects = GameObjects.Select(x => x.Id == User.Avatar.Id ? x with { Type = "Self" } : x).ToList();
        if (Game != null)
            await Game.InvokeVoidAsync("update", GameObjects);

    }

    void SetActiveTab(string tab)
    {
        ActiveTab = tab;
    }

    async Task Select(BlossomPost? post)
    {
        if (Game != null)
            await Game.InvokeVoidAsync("select", post?.Id);
    }
}
