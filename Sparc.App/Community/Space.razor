@page "/spaces/{Id}"
@page "/spaces/{Id}/{CurrentPage}"

@if (CurrentSpace is not null)
{
    <article>
        <aside>
            <header>
                <h1>@CurrentSpace.Name</h1>
                <p>@CurrentSpace.Summary.Topic<br /><br /></p>
                @if (CurrentSpace.RoomType == "Facet")
                {
                    <p>Goal: @CurrentSpace.Summary.Description</p>
                }
                <dl>
                    <dt>Stage:</dt>
                    <dd>Ideation</dd>
                    <dt>Last Updated:</dt>
                    <dd>@CurrentSpace.LastActiveDate?.ToShortDateString()</dd>
                    <dt>Consensus:</dt>
                    <dd>@CurrentSpace.Consensus?.ToString("N2")
                        (@(CurrentSpace.ConsensusDelta > 0 ? "rising" : CurrentSpace.ConsensusDelta < 0 ? "falling" : "stable"))
                    </dd>
                    <dt>Confidence:</dt>
                    <dd>@CurrentSpace.Confidence?.ToString("N2")
                        (@(CurrentSpace.ConfidenceDelta > 0 ? "rising" : CurrentSpace.ConfidenceDelta < 0 ? "falling" : "stable"))
                    </dd>
                    @if (CurrentSpace.RoomType == "Facet")
                    {
                        <dt>Left Side:</dt>
                        <dd>@CurrentSpace.Summary.LeftTopic</dd>
                        <dt>Right Side:</dt>
                        <dd>@CurrentSpace.Summary.RightTopic</dd>
                    }
                </dl>

                <div>
                    <button class="secondary">Edit</button>
                </div>
            </header>

            <nav>
               @*  <h2>Subspaces</h2>
                <ul>
                    @foreach (var subspace in Subspaces.Where(x => x.RoomType == "Space"))
                    {
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <path d="M10 7L15 12L10 17" stroke="#525252" stroke-width="1.2" stroke-linecap="square" stroke-linejoin="round" />
                            </svg>
                            <a href="@($"/spaces/{subspace.Id}")">@subspace.Name (CONS: @subspace.Consensus?.ToString("N2"), CONF: @subspace.Confidence?.ToString("N2"))</a>
                        </li>
                    }
                </ul> *@

                <h2>Challenges</h2>
                <ul>
                    @foreach (var subspace in Subspaces.Where(x => x.RoomType == "Facet").OrderByDescending(x => x.Weight))
                    {
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <path d="M10 7L15 12L10 17" stroke="#525252" stroke-width="1.2" stroke-linecap="square" stroke-linejoin="round" />
                            </svg>
                            <a href="@($"/spaces/{subspace.Id}")">@subspace.Name (VAR: @subspace.Weight?.ToString("P0"))</a>
                        </li>
                    }
                </ul>

                <h2>Members</h2>
                <ul>
                    @foreach (var member in Subspaces.Where(x => x.RoomType == "User"))
                    {
                        <li>
                            @member.Name (X: @member.X)
                        </li>
                    }
                </ul>

                <h2>Pages</h2>
                <ul>
                    @foreach (var subpage in Pages)
                    {
                        <li class="@(CurrentPage == subpage ? "selected " : "")">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <path d="M10 7L15 12L10 17" stroke="#525252" stroke-width="1.2" stroke-linecap="square" stroke-linejoin="round" />
                            </svg>
                            <a href="@($"/spaces/{CurrentSpace.Id}/{subpage}")">@subpage</a>
                        </li>
                    }
                </ul>
            </nav>
        </aside>

        <section>
            @if (CurrentPage == "Overview")
            {
                <SpaceOverview Space="CurrentSpace" />
            }
            else if (CurrentPage == "Discussion")
            {
                <SpaceDiscussion Space="CurrentSpace" />
            }
            @* else if (CurrentPage == "Tasks")
            {
                <SpaceTasks Space="CurrentSpace" />
            }
            else if (CurrentPage == "Files")
            {
                <SpaceFiles Space="CurrentSpace" />
            } *@
            else
            {
                <p>Page not found.</p>
            }
        </section>
    </article>
}

@code {
    [Parameter] public required string Id { get; set; }
    [Parameter] public string CurrentPage { get; set; } = "Discussion";
    BlossomSpace? CurrentSpace;
    List<BlossomSpace> Subspaces = [];
    List<string> Pages = ["Overview", "Discussion", "Tasks", "Files"];

    protected override async Task OnParametersSetAsync()
    {
        CurrentSpace = await Spaces.GetSpaceAsync(Id);
        Subspaces = await Spaces.GetSpacesAsync(Id);
        Subspaces = Subspaces.OrderByDescending(x => x.Confidence).ToList();
        if (string.IsNullOrWhiteSpace(CurrentPage))
            CurrentPage = "Discussion";
    }
}
