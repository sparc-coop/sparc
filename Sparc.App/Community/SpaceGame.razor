<div id="game"></div>

@code {
    [Parameter] public required List<Blossom.Content.BlossomCoordinate> GameObjects { get; set; } = [];
    IJSObjectReference? Game;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Game == null)
        {
            Game = await Js.ImportAsync("./SpaceGame/SpaceGame.js");
            await Game.InvokeVoidAsync("start", GameObjects);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Game != null)
            await Game.InvokeVoidAsync("update", GameObjects);
    }
}
