<form @onsubmit="AddPost" @onsubmit:preventDefault=true>
    <textarea placeholder="Search or type anything..." @onkeydown="Enter" @onkeydown:preventDefault=IsEnter @bind=PostText @bind:event="oninput"></textarea>

    @if (Error is not null)
    {
        <p class="error">@Error</p>
    }
</form>

@code {
    [Parameter] public BlossomSpace Space { get; set; } = new(Guid.NewGuid().ToString()) { SpaceId = "sparc.coop" };
    [Parameter] public EventCallback OnUpdate { get; set; }
    string PostText { get; set; } = string.Empty;
    bool IsEnter;
    string? Error;
    BlossomUser? User;

    protected override async Task OnInitializedAsync()
    {
        User = await Aura.UserInfo();
    }

    public async Task Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            IsEnter = true;
            await AddPost();
        }
        else
            IsEnter = false;
    }

    private async Task AddPost()
    {
        PostText = PostText.TrimEnd('\r', '\n');
        Error = null;
        Post post = new(Space, User!.Avatar, PostText);
        var newPost = await Spaces.PostAsync(post.SpaceId, post);
        if (OnUpdate.HasDelegate)
        {
            await OnUpdate.InvokeAsync();
            PostText = string.Empty;
        }
        else
            Nav.NavigateTo($"/spaces/{newPost.SpaceId}", true);
    }
}
