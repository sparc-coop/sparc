@page "/spaces/{Id}"
@page "/spaces/{ParentSpaceId}/subspaces/{Id}"

<article>
    <div id="game"></div>

    @if (GameState is not null)
    {
        <div id="buttons">
            @* @if (GameState.AvailableQuests.Any())
        {
            <button @onclick="ToggleQuests">
                <img src="./SpaceGame/starfield/sprites/exclamation.png" alt="Show Quests" />
            </button>
        } *@
        </div>

        @*         @if (ShowQuests)
        {
            <Quests AvailableQuests="GameState.AvailableQuests" UserSpace="GameState.Self" OnUpdate="UpdateGameObjects" />
        }
 *@
        <div id="hud">
            <section class="project">
                <header>
                    Project
                </header>
                <SpaceCard Space="GameState.Space" />
            </section>

            <section class="details">
                <header>
                    <ul>
                        <li class="@(ActiveTab == "Post" ? "active" : "")" @onclick="@(() => SetActiveTab("Post"))">Discoveries</li>
                        <li class="@(ActiveTab == "Fact" ? "active" : "")" @onclick="@(() => SetActiveTab("Fact"))">Facts</li>
                        <li class="@(ActiveTab == "Question" ? "active" : "")" @onclick="@(() => SetActiveTab("Question"))">Guides</li>
                    </ul>
                </header>

                <div class="discoveries">
                    <Discussion GameState="GameState" OnUpdate="UpdateGameObjects" OnSelect="Select" Type="@ActiveTab" @ref="SpaceDiscussionRef" />
                </div>
            </section>
        </div>
    }
</article>

@inject ISparcAura Aura
@code {
    [Parameter] public required string Id { get; set; }
    [Parameter] public string? ParentSpaceId { get; set; }
    List<Post> Discoveries = [];
    BlossomSpaceObject? SelectedQuest;
    BlossomUser? User;
    Discussion? SpaceDiscussionRef;
    IJSObjectReference? Game;
    string ActiveTab = "Post";
    bool ShowQuests;
    GameState? GameState;

    protected override async Task OnParametersSetAsync()
    {
        User = await Aura.UserInfo();
        await UpdateGameObjects();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Game == null)
        {
            Game = await Js.ImportAsync("./SpaceGame/SpaceGame.js");
            await Game.InvokeVoidAsync("start", GameState);
        }
    }

    async Task UpdateGameObjects()
    {
        GameState = await Spaces.GetCoordinatesAsync(Id);

        try
        {
            if (Game != null)
                await Game.InvokeVoidAsync("update", GameState, DotNetObjectReference.Create(this));
        }
        catch
        { }
    }

    void SetActiveTab(string tab)
    {
        ActiveTab = tab;
    }

    async Task Select(BlossomSpaceObject? obj)
    {
        var path = await Spaces.TravelAsync(Id, obj?.Id ?? "self");
        await Select(obj?.Id, path);
    }

    async Task Select(string? id, List<QuestPath> path)
    {
        if (Game != null)
            await Game.InvokeVoidAsync("select", id, path);
    }

    async Task SelectQuest(BlossomSpaceObject quest)
    {
        if (SelectedQuest?.Id == quest?.Id)
            SelectedQuest = null;
        else
            SelectedQuest = quest;

        await UpdateGameObjects();
    }

    [JSInvokable("SelectGameObject")]
    public async Task SelectGameObject(string id)
    {
        var obj = GameState!.SpaceObjects.FirstOrDefault(x => x.Id == id);
        if (obj != null)
        {
            if (obj.EntityType == "Quest")
                await SelectQuest(obj);
            else
                await SpaceDiscussionRef!.Select(obj.Id);
        }
    }

    void ToggleQuests() => ShowQuests = !ShowQuests;
}