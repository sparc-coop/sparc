<form @onsubmit="AddPost">
    <label class="eight-bit">
        <input placeholder="Tell us what's broken..."
               @bind=PostText
               @bind:event="oninput"
               disabled="@(IsSending != null)">
        </input>
    </label>
    <button class="eight-bit" disabled="@(IsSending != null)">
        @(IsSending == null ? "Send" : IsSending == true ? "Sending..." : "Sent!")
    </button>
</form>

@code {
    [Parameter] public BlossomSpace? Space { get; set; }
    [Parameter] public EventCallback OnUpdating { get; set; }
    [Parameter] public EventCallback<BlossomSpace> OnUpdate { get; set; }
    string PostText { get; set; } = string.Empty;
    bool? IsSending;
    BlossomUser? User;

    protected override async Task OnInitializedAsync()
    {
        User = await Aura.UserInfo();
    }

    public async Task Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
            await AddPost();
    }

    private async Task AddPost()
    {
        if (OnUpdating.HasDelegate)
            await OnUpdating.InvokeAsync();

        IsSending = true;
        PostText = PostText.TrimEnd('\r', '\n');

        if (Space == null)
        {
            var newSpace = new BlossomSpace("sparc.coop", Guid.NewGuid().ToString());
            Post post = new(newSpace, User!.Avatar, PostText);
            var createdSpace = await Spaces.CreateSpaceAsync(post);
            if (OnUpdate.HasDelegate)
                await OnUpdate.InvokeAsync(createdSpace);
            else
                Nav.NavigateTo($"/spaces/{createdSpace.Id}", true);
        }
        else
        {
            Post post = new(Space, User!.Avatar, PostText);
            var newPost = await Spaces.PostAsync(post.RealmId, post);
            PostText = string.Empty;
            if (OnUpdate.HasDelegate)
                await OnUpdate.InvokeAsync(Space);
        }

        IsSending = false;
    }
}
