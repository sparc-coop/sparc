@using Sparc.Blossom.Content

<section class="discussion">
    <div>
        @foreach (var item in GameState.SpaceObjects.Where(x => x.EntityType == Type))
        {
            <article @onclick=@(() => Select(item)) class="@(SelectedObject == item ? "selected" : "")">
                <header>
                    @if (item.EntityType == "Post")
                    {
                        <figure>
                            <img src="SpaceGame/starfield/sprites/orb 24x24.png" alt="@item.User?.Name" />
                            <figcaption>
                                @item.User?.Name
                                <time datetime="@item.Timestamp">@Ago(item.Timestamp)</time>
                                | @item.Distance.Pretty() parsecs | Temperature: @item.Temperature.ToString("0.00") K
                                | Collapse: @item.CollapseScale.ToString("0.00")
                            </figcaption>
                        </figure>
                    }
                    else
                    {
                        <figure>
                            @if (item.EntityType == "Fact")
                            {
                                <img src="SpaceGame/starfield/sprites/asteroid.png" alt="Fact" />
                            }
                            else
                            {
                                <img src="SpaceGame/starfield/sprites/diamond.png" alt="Question" />
                            }
                            <figcaption>
                                @item.Distance.Pretty() parsecs | Collapse: @item.CollapseScale.ToString("0.00")
                            </figcaption>
                        </figure>
                    }
                    <img src="img/VerticalMenu.svg" alt="Options" />
                </header>
                <section>
                    <p>@item.Text</p>
                </section>
                <footer>
                    <button class="secondary">Comments</button>
                    <button class="secondary">Like</button>
                    <button class="secondary">Quote</button>
                </footer>
            </article>
        }
    </div>
    <footer>
        <PostForm Space="GameState.Answer" OnUpdate="Update" />
    </footer>
</section>

@code {
    [Parameter] public required GameState GameState { get; set; }
    [Parameter] public EventCallback OnUpdate { get; set; }
    [Parameter] public EventCallback<BlossomSpaceObject?> OnSelect { get; set; }
    [Parameter] public string? Type { get; set; }
    BlossomSpaceObject? SelectedObject;

    async Task Update()
    {
        await OnUpdate.InvokeAsync();
    }

    public async Task Select(string id)
    {
        var post = GameState.SpaceObjects.FirstOrDefault(x => x.Id == id);
        if (post != null)
            await Select(post);
    }

    async Task Select(BlossomSpaceObject obj)
    {
        if (SelectedObject == obj)
            SelectedObject = null;
        else
            SelectedObject = obj;

        await OnSelect.InvokeAsync(SelectedObject);
    }

    string Ago(DateTime timestamp)
    {
        var span = DateTime.UtcNow - timestamp;
        if (span.TotalDays >= 365)
        {
            return $"{(int)(span.TotalDays / 365)}y ago";
        }
        else if (span.TotalDays >= 30)
        {
            return $"{(int)(span.TotalDays / 30)}mo ago";
        }
        else if (span.TotalDays >= 1)
        {
            return $"{(int)span.TotalDays}d ago";
        }
        else if (span.TotalHours >= 1)
        {
            return $"{(int)span.TotalHours}h ago";
        }
        else if (span.TotalMinutes >= 1)
        {
            return $"{(int)span.TotalMinutes}m ago";
        }
        else
        {
            return "just now";
        }
    }
}
