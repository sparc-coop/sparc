<section>
    <header>
        Quests
    </header>

    <figure>
        <img src="./SpaceGame/starfield/sprites/gm.png" />
        <figcaption>
            Here is the list of quests.
        </figcaption>
    </figure>

    <ul id="quests">
        @foreach (var quest in AvailableQuests)
        {
            <li class="@(UserSpace.ActiveQuestId == quest.Id ? "active" : "")">
                <div>
                    <figure></figure>
                    <aside>@quest.Distance.Pretty() ly</aside>
                </div>
                <div>
                    <h3>@quest.Summary?.RightTopic</h3>
                    <p>@(quest.Hint ?? quest.Summary?.Description)</p>
                </div>

                @if (UserSpace.ActiveQuestId == quest.Id)
                {
                    <button class="icon" @onclick="@(() => ToggleQuest(quest))">
                        <img src="./SpaceGame/starfield/sprites/start_quest.png" alt="Stop Quest" />
                    </button>
                }
                else
                {
                    <button class="icon" @onclick="@(() => ToggleQuest(quest))">
                        <img src="./SpaceGame/starfield/sprites/start_quest.png" alt="Go to Quest" />
                    </button>
                }
            </li>
        }
    </ul>
</section>


@code {
    [Parameter] public required List<Quest> AvailableQuests { get; set; }
    [Parameter] public required BlossomSpace UserSpace { get; set; }
    [Parameter] public EventCallback OnUpdate { get; set; }

    async Task ToggleQuest(Quest quest)
    {
        await Spaces.ActivateQuestAsync(quest.SpaceId, "");
        await OnUpdate.InvokeAsync();
    }
}